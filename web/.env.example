# Optional: leave empty for built-in demo generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set true to force demo mode even when a key is configured.
MARKETPILOT_DEMO_MODE=false

# Supabase public app credentials (not a service-role/secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for scheduled publishing; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# V2 free-tier branded image generation through Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Social account OAuth and encrypted token storage.
# Generate SOCIAL_TOKEN_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_PUBLIC_APP_URL=http://localhost:3000
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Scheduled publishing. Generate CRON_SECRET with the same random-key command used above.
CRON_SECRET=
AUTO_PUBLISH_TIMEZONE=Asia/Colombo
